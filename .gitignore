# Godot 4+ specific ignores
.godot/
/android/
/build/
*.tmp
__pycache__/
*.pyc

# IDE / AI assistants
.gemini/

# Export / dump local (não versionar — colide com scripts do projeto no CI)
/code_orbs/
/code_orbs.zip
*.exe
*.pck
*.console.exe

# Scripts de teste temporários
/test_load.gd
/test_load.gd.uid

# Não ignore export_presets.cfg — o GitHub Actions precisa dele no repositório.
# Credenciais de Android/Windows signing NÃO devem ir para o git (use secrets).
# Logs locais do smoke/CI
import.log
smoke.log
validate.log
