config_type_box = SubResource("Resource_2cvbo")
use_custom_tutorial = true
custom_tutorial_title = "Fase 1: Ponto de Partida — A Aparência Engana"
custom_tutorial_text = "Na matemática da escola, 5 e 5.0 parecem a mesma coisa. Mas, para o hardware do computador, eles são espécies completamente diferentes!

Na bancada existem 5 Orbes brutos esperando classificação. Use o Inspetor se tiver dúvida e arraste cada Orbe para a caixa do seu tipo correto (Int para inteiros ou Float para ponto flutuante)."

