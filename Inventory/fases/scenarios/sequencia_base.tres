[sub_resource type="Resource" id="step_5"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_5")
use_custom_tutorial = true
custom_tutorial_title = "Conversão pela Adição"
custom_tutorial_text = "O Conversor foi desligado nesta fase! Para guardar os valores da bancada ([b]100[/b] em [b]short[/b] de 2 bytes, [b]0.25[/b] em [b]float[/b] de 4 bytes e [b]10.5[/b] em [b]double[/b] de 8 bytes) na sua Mochila de [b]8 bytes[/b], você terá que fundir Orbes somando seus valores.

Para isso, entra em ação a [b]Calculadora[/b], que permite somar dois Orbes — mas atenção: nesta fase ela tem apenas [b]2 usos[/b] disponíveis!

Quando você junta dois Orbes de tipos diferentes na Calculadora, a máquina promove o resultado automaticamente para o tipo mais forte entre eles. Se o resultado virar um [b]double[/b], ele consumirá os 8 bytes da Mochila sozinho; e se um decimal fosse forçado para [b]short[/b], você perderia as casas depois da vírgula. Planeje bem os seus dois cálculos antes de somar!"

