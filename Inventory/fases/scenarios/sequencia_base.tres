[sub_resource type="Resource" id="step_1"]
script = ExtResource("2_step")
kind = 2
config_type_box = SubResource("cfg_1")
use_custom_tutorial = true
custom_tutorial_title = "Ponto de Partida Inicial"
custom_tutorial_text = "Bem-vindo ao [b]Code Orbs[/b]! Na matemática do dia a dia, escrever [b]5[/b] ou [b]5.0[/b] dá exatamente no mesmo, mas dentro da memória do computador eles têm estruturas completamente diferentes.

À direita, na [b]Bancada[/b], há 6 Orbes esperando por você: [b]5[/b], [b]-18[/b], [b]5.0[/b], [b]0.25[/b], [b]0.0[/b] e [b]10.5[/b]. Para começar, arraste cada um para a caixa correspondente à esquerda: a caixa [b]Int[/b] (com 2 espaços) guarda os números inteiros, enquanto a caixa [b]Float[/b] (com 4 espaços) recebe os números com ponto decimal.

Antes de guardá-los, experimente arrastar um Orbe até o [b]Inspecionador[/b] para abrir um \"raio-X\" dos seus bits internos. Veja o que acontece se você tentar colocar o [b]5.0[/b] na caixa de inteiros e repare como até o próprio zero ([b]0.0[/b]) ocupa espaço e precisa de um tipo para existir na máquina!"

