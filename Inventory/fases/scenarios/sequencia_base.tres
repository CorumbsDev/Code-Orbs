[sub_resource type="Resource" id="step_2"]
script = ExtResource("2_step")
kind = 2
config_type_box = SubResource("cfg_2")
use_custom_tutorial = true
custom_tutorial_title = "Tipos de Dados"
custom_tutorial_text = "Você já sabe separar inteiros de números com ponto decimal, mas já reparou como a programação tem vários nomes diferentes para guardar números? Isso acontece porque \"inteiro\" e \"ponto flutuante\" não são tipos únicos, mas famílias com diferentes tamanhos e cores na memória.

Os 6 Orbes na bancada são os mesmos de antes ([b]5[/b], [b]-18[/b], [b]5.0[/b], [b]0.25[/b], [b]0.0[/b] e [b]10.5[/b]), mas agora você tem 6 caixas diferentes à esquerda: [b]short int[/b], [b]int[/b], [b]fp8[/b], [b]fp16[/b], [b]float[/b] e [b]double[/b]. Desta vez, cada caixa tem espaço para apenas [b]1 Orbe[/b] e se fecha assim que é preenchida.

Distribua os 2 inteiros e os 4 decimais entre todas as caixas para avançar. Repare em como cada tipo veste o Orbe com uma cor própria — já na próxima fase, você vai descobrir o peso real que cada uma dessas cores ocupa na memória!"

