[sub_resource type="Resource" id="step_8"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_8")
use_custom_tutorial = true
custom_tutorial_title = "A Ilusão do Float"
custom_tutorial_text = "Muita gente imagina que o [b]float[/b] (4 bytes) só serve para números pequenos e o [b]double[/b] (8 bytes) para números gigantes. Na verdade, o [b]float[/b] consegue alcançar a casa dos bilhões, mas esconde um ponto fraco: seus [b]23 bits de Mantissa[/b] só guardam cerca de 7 dígitos com precisão exata!

Você tem dois Orbes [b]double[/b] (8 bytes cada) na bancada — [b]16.777.219.0[/b] e [b]1.024.5[/b] — somando 16 bytes para uma Mochila de [b]12 bytes[/b]. Isso significa que apenas um deles precisa ser reduzido para [b]float[/b] (4 bytes).

Experimente converter o [b]16.777.219.0[/b] para [b]float[/b] e observe no [b]Inspecionador[/b] como os 23 bits da mantissa esgotam sua capacidade, arredondando o final do número para [b]16.777.220.0[/b] por conta própria! Veja qual dos dois Orbes pode encolher para 4 bytes sem sofrer nenhuma distorção."

