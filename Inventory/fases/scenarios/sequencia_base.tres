[sub_resource type="Resource" id="step_9"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_9")
use_custom_tutorial = true
custom_tutorial_title = "Espremendo a Mantissa"
custom_tutorial_text = "Em placas de vídeo e sensores, muitas vezes vale a pena aceitar um pequeníssimo arredondamento nas últimas casas decimais em troca de economizar metade da memória RAM. É aí que entra um novo tipo no seu Conversor: o Orbe amarelo [b]FP16[/b] (meia precisão, de [b]2 bytes[/b]), que divide seu espaço em apenas [b]5 bits de Expoente[/b] (alcance máximo de [b]65.504[/b]) e [b]10 bits de Mantissa[/b].

Seu desafio é comprimir dois dos três Orbes [b]float[/b] da bancada ([b]3.14159[/b], [b]2.71828[/b] e [b]500.000.0[/b]) para que todos caibam nos [b]8 bytes[/b] da Mochila.

Repare que a Mochila aceita o leve arredondamento nas últimas casas de Pi e do número de Euler (dentro da margem de tolerância de [b]0.1%[/b]). Mas veja no Conversor o que acontece com os 5 bits de Expoente se você tentar espremer [b]500.000.0[/b] dentro de um [b]fp16[/b]!"

