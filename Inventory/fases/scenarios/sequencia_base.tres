[sub_resource type="Resource" id="step_14"]
script = ExtResource("2_step")
kind = 3
config_raw_mochila = SubResource("cfg_14")
use_custom_tutorial = true
custom_tutorial_title = "O Arquiteto de Sistema"
custom_tutorial_text = "Este é o seu teste de formatura como Arquiteto de Sistema! Na bancada estão cinco valores brutos de naturezas totalmente diferentes ([b]17[/b], [b]-40.000[/b], [b]0.25[/b], [b]0.0078125[/b] e [b]3.14159[/b]), e você dispõe de exatamente [b]13 bytes[/b] na Mochila.

Todas as seis [b]Estações de Tipagem[/b] estão abertas ([b]short int[/b], [b]int[/b], [b]fp8[/b], [b]fp16[/b], [b]float[/b] e [b]double[/b]), mas elas bloqueiam imediatamente qualquer escolha que provoque estouro, zeramento por underflow ou perda de precisão.

Analise cada número com calma: descubra qual dos dois inteiros cabe em 2 bytes ([b]short[/b]) e qual ultrapassa o limite de [b]-32.768[/b] exigindo 4 bytes ([b]int[/b]); depois, veja qual decimal é simples o bastante para morar em 1 byte ([b]fp8[/b]), qual precisa de [b]fp16[/b] (2 bytes) para não virar zero e qual exige os 23 bits de mantissa de um [b]float[/b] (4 bytes). Encontre o tipo ideal para cada um e feche os 13 bytes com perfeição!"
[resource]
script = ExtResource("1_list")
steps = Array[ExtResource("2_step")]([SubResource("step_1"), SubResource("step_2"), SubResource("step_3"), SubResource("step_4"), SubResource("step_5"), SubResource("step_6"), SubResource("step_7"), SubResource("step_8"), SubResource("step_9"), SubResource("step_10"), SubResource("step_11"), SubResource("step_12"), SubResource("step_13"), SubResource("step_14")])
