[sub_resource type="Resource" id="step_10"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_10")
use_custom_tutorial = true
custom_tutorial_title = "O Abismo do Underflow"
custom_tutorial_text = "Você já viu números explodirem quando são grandes demais para o tipo ([b]Overflow[/b]). Agora vai conhecer o perigo oposto: o [b]Underflow[/b], que acontece quando uma fração é tão pequenininha e próxima de zero que o tipo de dado não consegue representá-la e colapsa seu valor para [b]0.0[/b]!

Para testar esse limite, o Conversor liberou o Orbe branco [b]FP8[/b] ([b]1 byte[/b]), um formato ultracompacto que conta com apenas [b]4 bits de Expoente[/b] e [b]3 bits de Mantissa[/b].

Na bancada há quatro Orbes em [b]fp16[/b] ([b]1.5[/b], [b]2.25[/b], [b]0.5[/b] e [b]0.00008[/b]) para uma Mochila minúscula de [b]5 bytes[/b]. Reduza para [b]fp8[/b] tudo o que for seguro para economizar espaço, mas cuidado: nesta fase é proibido deixar qualquer Orbe zerar por Underflow!"

[sub_resource type="Resource" id="cfg_11"]
