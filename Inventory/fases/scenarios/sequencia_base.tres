[sub_resource type="Resource" id="step_7"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_7")
use_custom_tutorial = true
custom_tutorial_title = "O Corte Seco"
custom_tutorial_text = "Quando você joga um número com vírgula (como [b]4.5[/b] ou [b]3.5[/b]) direto no Conversor para um tipo inteiro ([b]short int[/b]), o computador não arredonda o valor: ele faz um [b]Truncamento[/b], decepando a parte [b].5[/b] a frio e tirando suas estrelas de precisão!

Nesta fase, sua Mochila tem [b]6 bytes[/b] e você precisa guardar nela o valor [b]2.25[/b] junto com o resultado da soma de [b]4.5 + 3.5[/b].

Em vez de converter os números antes da hora, use a [b]Calculadora[/b] primeiro para somar [b]4.5 + 3.5[/b]. Assim que o resultado virar um número inteiro exato terminado em [b].0[/b], passe-o pelo [b]Conversor[/b] e transforme-o em um [b]short int[/b] de 2 bytes sem perder absolutamente nada!"

