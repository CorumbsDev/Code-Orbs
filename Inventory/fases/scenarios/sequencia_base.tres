[sub_resource type="Resource" id="step_13"]
script = ExtResource("2_step")
kind = 3
config_raw_mochila = SubResource("cfg_13")
use_custom_tutorial = true
custom_tutorial_title = "Primeira Declaração"
custom_tutorial_text = "Bem-vindo às Fases Híbridas! A partir de agora, você vai agir exatamente como um programador declarando variáveis do zero no código.

Repare que os quatro Orbes na bancada ([b]15[/b], [b]-300[/b], [b]4.5[/b] e [b]0.5[/b]) nasceram brutos — cinzas e sem nenhum tipo definido —, mas precisam ser guardados em uma Mochila de [b]10 bytes[/b].

Antes de levar um Orbe bruto até a Mochila, arraste-o para uma das [b]Estações de Tipagem[/b] no centro da tela ([b]short int[/b], [b]int[/b], [b]fp16[/b], [b]float[/b] ou [b]double[/b]) para batizá-lo com um tipo e uma cor. Escolha com sabedoria: se você usar tipos grandes demais sem necessidade — como declarar [b]15[/b] e [b]-300[/b] como [b]int[/b] de 4 bytes —, os Orbes vão passar do limite e travar sua Mochila!"

