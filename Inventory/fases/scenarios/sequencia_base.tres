[sub_resource type="Resource" id="step_12"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_12")
use_custom_tutorial = true
custom_tutorial_title = "O Mestre dos Dados"
custom_tutorial_text = "Chegou o desafio final da Mochila com todo o seu arsenal liberado! Você tem cinco Orbes na bancada e precisa entregar quatro resultados finais ocupando exatamente os [b]15 bytes[/b] da Mochila.

O [b]40.000[/b] já nasceu como [b]int[/b] e não cabe em um short, então deixe-o como está. Já na soma de [b]16.777.216.0 + 1.0[/b], experimente observar um fenômeno novo: se você somá-los direto como [b]float[/b], ocorre a [b]Absorção de Mantissa[/b] — o [b]+ 1.0[/b] é completamente engolido porque os 23 bits do float não alcançam essa diferença, então promova um deles com o [b]Conversor[/b] antes de calcular! Atenção: a Calculadora só tem [b]1 uso[/b] nesta fase.

Por fim, comprima o [b]0.0005[/b] sem deixá-lo cair em Underflow para [b]0.0[/b] e coloque o [b]1.5[/b] na menor fôrma possível para fechar a conta nos 15 bytes cravados!"

