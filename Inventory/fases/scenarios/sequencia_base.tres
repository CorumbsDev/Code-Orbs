[sub_resource type="Resource" id="step_3"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_3")
use_custom_tutorial = true
custom_tutorial_title = "Está Apertado"
custom_tutorial_text = "As caixas saíram de cena para dar lugar à [b]Mochila[/b], que representa a Memória RAM do seu computador! Aqui o espaço é contado byte a byte: sua Mochila comporta apenas [b]8 bytes[/b] no total.

Na bancada, você recebeu três Orbes já tipados: [b]10[/b] em [b]short[/b] (2 bytes), [b]5[/b] em [b]int[/b] (4 bytes) e [b]8.5[/b] em [b]double[/b] (8 bytes). Somados, eles ocupam 14 bytes e não cabem todos na Mochila do jeito que estão.

Para resolver isso, você conta com uma ferramenta nova: o [b]Conversor[/b]. Antes de converter, passe o [b]5[/b] e o [b]8.5[/b] pelo [b]Inspecionador[/b] e veja quantos bits zerados estão sobrando dentro deles. Depois, use o Conversor para mudá-los para tipos menores e encaixar tudo na Mochila. Só tome cuidado para não converter o [b]8.5[/b] para um tipo inteiro ([b]int[/b] ou [b]short[/b]), ou a parte [b].5[/b] será cortada e você perderá precisão!"

