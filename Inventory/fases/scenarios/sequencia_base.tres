[sub_resource type="Resource" id="step_11"]
script = ExtResource("2_step")
kind = 0
config_mochila = SubResource("cfg_11")
use_custom_tutorial = true
custom_tutorial_title = "Quantização em Lote"
custom_tutorial_text = "Hora de pensar como um engenheiro otimizando um modelo de Inteligência Artificial! Na bancada estão cinco Orbes do tipo [b]float[/b] que pesam 20 bytes juntos ([b]1.25[/b], [b]3.5[/b], [b]3.33333[/b], [b]120.0[/b] e [b]1000.0[/b]), mas sua Mochila tem apenas [b]7 bytes[/b] de espaço.

Use o [b]Inspecionador[/b] e o [b]Conversor[/b] para escolher o tipo ideal de cada número, lembrando que nem todo valor com vírgula se comporta igual em binário: frações como [b].25[/b] e [b].5[/b] são potências exatas de base 2 e cabem perfeitamente em [b]fp8[/b] (1 byte) sem perder nada, enquanto dízimas como [b]3.33333[/b] se deformam nos 3 bits do fp8 e pedem a precisão do [b]fp16[/b] (2 bytes).

E fique de olho no [b]1000.0[/b]: ele passa do limite máximo do fp8 (448), mas será que um número terminado em [b].0[/b] precisa mesmo continuar em ponto flutuante?"

