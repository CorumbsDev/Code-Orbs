; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tcc"
run/main_scene="res://Inventory/fases/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataHandler="*res://Inventory/Data/data_handler.gd"
LearningPrefs="*res://Inventory/learning/learning_prefs.gd"
PhaseRunner="*res://Inventory/fases/phase_runner.gd"
OrbUI="*res://Inventory/ui/orb_ui.gd"
AchievementManager="*res://Inventory/Achievements/achievement_manager.gd"
AchievementOverlay="*res://Inventory/Achievements/achievement_overlay.gd"
BGMManager="*res://Inventory/bgm_manager.gd"

[display]

window/size/mode=2
window/stretch/mode="viewport"

[global_group]

item_1x1=""
item_1x2=""
item_2x1=""
item_2x2=""
item_number_5=""
item_operator_plus=""
item_number_7=""
slot=""
item_number_10=""

[gui]

theme/custom="res://Inventory/default_theme.tres"

[input]

select_item={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(346, 17),"global_position":Vector2(355, 65),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
rotate_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
